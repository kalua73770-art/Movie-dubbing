GEMINI_API_KEYS=key1,key2,key3
GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe
GEMINI_TEXT_MODELS=gemini-3.5-flash-lite,gemini-2.5-flash-lite
GEMINI_TTS_MODELS=gemini-2.5-flash-preview-tts,gemini-3.1-flash-tts-preview
TRANSCRIBE_CHUNK_SECONDS=1740
TRANSCRIBE_OVERLAP_SECONDS=20
TRANSLATION_BATCH_CHARS=10000
TTS_BATCH_SECONDS=600
TTS_BATCH_CHARS=8500
GEMINI_VOICES=Kore,Puck,Charon,Zephyr,Fenrir,Leda,Orus,Aoede
ORIGINAL_DUCK_DB=-40
WORK_DIR=/tmp/movie-dubbing
OUTPUT_DIR=/tmp/movie-dubbing/outputs

GEMINI_SPEAKER_MODEL=gemini-3.5-flash-lite
